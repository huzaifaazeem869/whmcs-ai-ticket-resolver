<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive environment & configuration files
    <FilesMatch "(^\.env|\.git|composer\.(json|lock)|package\.(json|lock)|\.sqlite)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    RewriteRule ^(\.env|\.git|storage/logs/|database/database\.sqlite) - [F,L,NC]

    # Rewrite all requests into the Laravel public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes
